{
	"compileOnSave": false,
	"compilerOptions": {
		"noImplicitAny": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"target": "es6",
		"lib": [
			"es2015",
			"dom"
		],
		"strictNullChecks": false,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": false
	},
	"exclude": [
		"node_modules"
	]
}
